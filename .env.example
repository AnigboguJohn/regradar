# ---- Required in production (generate with: openssl rand -hex 32) ----
JWT_SECRET=change-me-to-a-long-random-string
INTERNAL_TOKEN=change-me-internal-token
CRON_SECRET=change-me-cron-secret

# ---- AI (answers + impact analysis) ----
# Leave everything blank to run in FREE extractive mode (shows cited passages, no AI summary).
#
# FREE option A - Groq (no credit card): get a key at https://console.groq.com/keys
#   LLM_PROVIDER=groq
#   LLM_API_KEY=gsk_...
#
# FREE option B - Google Gemini (no credit card): get a key at https://aistudio.google.com/apikey
#   LLM_PROVIDER=gemini
#   LLM_API_KEY=AIza...
#   (Google may use free-tier data to improve its products: use sample data, not real client documents.)
#
# FREE option C - Ollama on your own computer (no key, no internet, needs 8GB+ RAM): https://ollama.com
#   then run:  ollama pull llama3.1:8b
#   LLM_PROVIDER=ollama
#
# PAID, best quality - Claude: https://platform.claude.com
#   ANTHROPIC_API_KEY=sk-ant-...
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
ANTHROPIC_API_KEY=

# Optional backup AI, used automatically when the main one fails or hits its free-tier limit
# (e.g. main = groq, backup = gemini). Check both keys with:  docker compose exec ai python -m app.check_llm
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=

# ---- Optional: semantic (vector) search on top of keyword search ----
# EMBEDDING_PROVIDER=voyage   + VOYAGE_API_KEY=...
# EMBEDDING_PROVIDER=openai   + OPENAI_API_KEY=...
EMBEDDING_PROVIDER=
VOYAGE_API_KEY=
OPENAI_API_KEY=

# ---- Optional: email alerts (any SMTP: Amazon SES, Gmail app password, Mailgun...) ----
# Without SMTP, alert emails are printed to the API logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=RegRadar <alerts@yourdomain.com>

# How often to check regulators when running with docker compose (minutes). 0 = off.
CRON_INTERVAL_MINUTES=180

# ---- reCAPTCHA ("I'm not a robot") on sign-up, sign-in and forgot-password ----
# These are Google's public TEST keys: the box always passes and shows a "for testing only" note.
# For production, create keys (type: reCAPTCHA v2, "I'm not a robot" checkbox) for your domain at
# https://www.google.com/recaptcha/admin and paste them here. Leave both empty to turn reCAPTCHA off.
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
